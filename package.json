{
  "name": "parkease",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm run client\" \"npm run server\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "install-all": "npm install",
    "build": "npm run build --workspace client",
    "lint": "eslint client server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}
